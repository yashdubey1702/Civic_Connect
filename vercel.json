{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/town_issues/?",
      "dest": "/public/index.html"
    },
    {
      "src": "/town_issues/(.*\\.php)$",
      "dest": "/api/index.php?__path=$1"
    },
    {
      "src": "/(admin|auth|public|reports|user|volunteers)/(.*\\.php)$",
      "dest": "/api/index.php?__path=$1/$2"
    },
    {
      "src": "/town_issues/(.*)$",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
