{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/town_issues/(assets|data|reports/uploads|uploads)/(.*)$",
      "headers": {
        "Location": "/$1/$2"
      },
      "status": 308
    },
    {
      "src": "/town_issues/(manifest\\.json|sw\\.js)$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "/(assets|data|reports/uploads|uploads)/(.*)$",
      "dest": "/$1/$2"
    },
    {
      "src": "/(manifest\\.json|sw\\.js)$",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/town_issues/?",
      "dest": "/public/index.html"
    },
    {
      "src": "/town_issues/public/index\\.html$",
      "dest": "/public/index.html"
    },
    {
      "src": "/town_issues/(.*\\.php)$",
      "dest": "/api/index.php?__path=$1"
    },
    {
      "src": "/(admin|auth|public|reports|user|volunteers)/(.*\\.php)$",
      "dest": "/api/index.php?__path=$1/$2"
    },
    {
      "src": "/town_issues/(.*)$",
      "dest": "/api/index.php?__path=$1"
    },
    {
      "src": "/(.*)$",
      "dest": "/api/index.php?__path=$1"
    }
  ]
}
